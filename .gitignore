# Archives lourdes : originaux Cloudinary (107 Mo), journaux de migration,
# sauvegardes a la main. Gardees sur le disque, jamais poussees.
archives/

# Reglages personnels de l'outil : propres a chaque machine
.claude/settings.local.json

# Copies de sauvegarde a la main : git tient deja l'historique
*.avant-*

# Traces de l'outil Supabase (jetons de session, etat de liaison) :
# elles sont propres a chaque machine, et l'une d'elles porte un jeton.
supabase/.temp/

# Releve produit par outils/paires-tutoriel.py : on le lit, on ne le garde pas.
paires-tutoriel.txt

# Cache Python des outils
outils/__pycache__/
