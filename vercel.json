{
  "rewrites": [
    { "source": "/media/img/:name(.*)\\.png",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.PNG",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.jpg",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.JPG",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.jpeg", "destination": "/media/img/:name.webp" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://*.basemaps.cartocdn.com https://lmwbwasupqkvswukieav.supabase.co; connect-src 'self' https://api.unsplash.com https://lmwbwasupqkvswukieav.supabase.co wss://lmwbwasupqkvswukieav.supabase.co https://api.web3forms.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://www.tiktok.com; media-src 'self' blob: https://lmwbwasupqkvswukieav.supabase.co; worker-src 'self' blob:; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), usb=(), magnetometer=(), gyroscope=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin-matchs.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/refonte-admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
