{
  "rewrites": [
    { "source": "/media/img/:name(.*)\\.png",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.PNG",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.jpg",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.JPG",  "destination": "/media/img/:name.webp" },
    { "source": "/media/img/:name(.*)\\.jpeg", "destination": "/media/img/:name.webp" }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
